  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: Question 19
  m_EditorClassIdentifier: 
  questionText: 'Which of the following is true for using the quadrat method?

'
  referenceImage: {fileID: 0}
  explanationText: 'The quadrat method helps in calculating the number of individuals
    of each species, with inexpensive equipment and easy fieldwork. The results from
    sampled quadrats can be extrapolated to the entire given field of vegetation.

'
  options:
  - 'The quadrat method helps in calculating the number of individuals of each species.  '
  - 'The results from sampled quadrats can then be extrapolated to the entire given
    field of vegetation. '
  - 'It is inexpensive and easy fieldwork. '
  - 'All of the above '
  correctOptionIndex: 3
