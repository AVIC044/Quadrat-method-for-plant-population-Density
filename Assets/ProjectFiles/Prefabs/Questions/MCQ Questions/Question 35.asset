  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: Question 35
  m_EditorClassIdentifier: 
  questionText: 'Which of the following is true about this quadrat?

'
  referenceImage: {fileID: 0}
  explanationText: 'We observe that both Medicago polymorpha (species A) and Evolvulus
    nummularius (species B) thrive in this quadrat. The open sunlight favours the
    growth of species A, while the increased disturbances favour the growth of species
    B, while it inhibits the growth of Spermacoce pusilla (species C).

'
  options:
  - 'Medicago polymorpha (species A) is more abundant. '
  - 'Evolvulus nummularius (species B) is more abundant. '
  - 'Spermacoce pusilla (species C) is moderately abundant. '
  - 'Both species A and B are more or less equally abundant as compared to species
    C. '
  correctOptionIndex: 3
