  m_Name: Question 50
  m_EditorClassIdentifier: 
  questionText: 'Which species occurs more in this quadrat?

'
  referenceImage: {fileID: 0}
  explanationText: 'We observe that Evolvulus nummularius, species B, with more individuals,
    thrives more in this quadrat which is favoured by a partial shade. Its flourish,
    despite the increased of grazing in the area, also indicates it to be a dominant
    species.

    

'
  options:
  - Medicago polymorpha (species A)
  - 'Evolvulus nummularius (species B) '
  - 'Spermacoce pusilla (species C) '
  - 'Both species A and B '
  correctOptionIndex: 1
