  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: Question 23
  m_EditorClassIdentifier: 
  questionText: Select the correct formula for population density.
  referenceImage: {fileID: 0}
  explanationText: 'The formula to calculate the plant population density is: Density
    = Total number of individuals of the species in all the sampling units (S) /
    Total number of sampling units studied (Q)

    

'
  options:
  - 'Density/Q = S '
  - 'Density = Q/S '
  - 'Density = S/Q '
  - 'Density /S = Q '
  correctOptionIndex: 2
