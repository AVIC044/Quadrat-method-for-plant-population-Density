  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: Question 60
  m_EditorClassIdentifier: 
  questionText: 'Let us conclude based on our observations. Which species shows the
    highest density?

'
  referenceImage: {fileID: 0}
  explanationText: 'Therefore, out of the three herbaceous plant species found in
    the area, Evo/vulus nummularius (species B) was the dominant species as it survived
    severe disturbances like grazing and was not asaffected by the absence or presence
    of light. Hence, its density was the highest.

'
  options:
  - 'Medicago polymorpha (species A) '
  - 'Evolvulus nummularius (species B)  '
  - 'Spermacoce pusilla (species C)  '
  - 'Both species A and B  '
  correctOptionIndex: 1
